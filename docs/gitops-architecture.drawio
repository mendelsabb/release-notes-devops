elBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="⑦ PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CF222E;strokeWidth=2;fontSize=11;fontColor=#CF222E;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="⑧ pull by digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2496ED;strokeWidth=1.5;fontSize=11;fontColor=#2496ED;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1162" y="871"/></Array></mxGeometry></mxCell><mxCell id="c79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2496ED;strokeWidth=1.5;fontSize=11;fontColor=#2496ED;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1552" y="905"/></Array></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;Flow&lt;/b&gt;&amp;nbsp;&amp;nbsp; ① &lt;code&gt;make up&lt;/code&gt; creates the only hand-made Argo CD object, the root app (pointed at your GitHub origin). ② The root syncs &lt;b&gt;gitops/argocd/&lt;/b&gt;: the AppProject and the ApplicationSet. ③ The ApplicationSet&#x27;s Git directory generator turns every folder in &lt;b&gt;gitops/environments/&lt;/b&gt; into an Application (new folder = new environment, once its namespace is allowed in the AppProject). ④ Each Application renders the same chart &lt;b&gt;helm/release-notes/&lt;/b&gt; with its folder&#x27;s values.yaml + image.yaml (prod the same way). ⑤ Argo CD syncs in waves: Postgres → migration Job → API → HPA/PDB. ⑥ A merge to main → CI builds once, pushes to GHCR and commits the digest to &lt;b&gt;dev/image.yaml&lt;/b&gt; → dev updates by itself. ⑦ Prod only changes through a reviewed PR to &lt;b&gt;prod/image.yaml&lt;/b&gt;: promote (dev&#x27;s exact digest) or rollback (a previous one). ⑧ Pods pull the image by immutable digest. Environments are folders on one branch, not branches." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;strokeWidth=1;fontSize=12;fontColor=#1F2328;align=left;verticalAlign=top;spacingLeft=6;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1720" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>